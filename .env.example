# packages/backend — copy to packages/backend/.env and fill in real values
DATABASE_URL=postgresql+asyncpg://wandr:wandr@localhost:5432/wandr
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=sk-ant-your-key-here
JWT_SECRET_KEY=change-me-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MCP server URLs
MCP_WEB_SEARCH_URL=https://search.mcp.anthropic.com
MCP_MAPS_URL=https://maps.mcp.anthropic.com
MCP_WEATHER_URL=https://weather.mcp.anthropic.com
MCP_CURRENCY_URL=https://currency.mcp.anthropic.com
MCP_CALENDAR_URL=https://gcal.mcp.claude.com/mcp

# Feature flags
ENABLE_CALENDAR_MCP=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=wandr-backend

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# packages/frontend — copy to packages/frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1your-token-here
